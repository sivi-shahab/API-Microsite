# Template konfigurasi Microsite OCR Service.
#
#   cp .env.example .env && chmod 600 .env
#
# Isi nilai rahasia di .env saja; .env tidak di-commit (lihat .gitignore) dan tidak
# ikut ke image (lihat .dockerignore). Buat key/sandi acak dengan: openssl rand -hex 32
# Variabel yang dikosongkan memakai default di docker-compose.yml / microsite_ocr/config.py.

# --- Rahasia (wajib untuk docker compose) ---------------------------------------
# Header X-API-Key yang wajib dikirim client ke service ini.
SERVICE_API_KEY=
# Header X-API-Key ke OCR API; salah satu nilai API_KEYS di /data/ocr-qwen/.env.
OCR_API_KEY=
# Sandi user PostgreSQL; DATABASE_URL container api dirakit otomatis dari nilai ini.
POSTGRES_PASSWORD=

# --- Rahasia (opsional) ----------------------------------------------------------
# API key service verification CompreFace. Kosong = face similarity tidak dihitung.
FACE_API_KEY=

# --- Layanan hulu ------------------------------------------------------------------
DMS_BASE_URL=http://10.191.22.16:8688
OCR_BASE_URL=http://10.168.105.11:8070
# Di Docker, localhost menunjuk ke container itu sendiri; pakai host.docker.internal.
FACE_BASE_URL=http://host.docker.internal:8000

# --- Timeout (detik) -------------------------------------------------------------
DMS_TIMEOUT=30
OCR_TIMEOUT=120
FACE_TIMEOUT=30

# --- Kapasitas service -----------------------------------------------------------
MAX_WORKERS=4
MAX_TICKETS_PER_REQUEST=50

# --- Docker / jaringan -------------------------------------------------------------
# Port host untuk service (container selalu listen di 8090).
SERVICE_PORT=8090
# PostgreSQL hanya dibuka di 127.0.0.1 host.
POSTGRES_PORT=5432
POSTGRES_USER=microsite
POSTGRES_DB=microsite_ocr
# Samakan dengan MTU NIC server (enp1s0); 1500 membuat download dari DMS timeout.
DOCKER_MTU=1400
TZ=Asia/Jakarta

# --- Hanya untuk menjalankan CLI/service langsung di host (di luar Docker) ----------
# DATABASE_URL=postgresql://microsite:<sandi>@127.0.0.1:5432/microsite_ocr
